# AetherPeptide — environment variables
# Copy to .env.local for local dev. Set the same vars in Vercel for production.

# --- Beehiiv (newsletter + waitlist signups) ---
# Beehiiv dashboard → Settings → Integrations → API → create a key.
BEEHIIV_API_KEY=
# Beehiiv publication id (looks like "pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx").
# Find it in the API docs page, or Settings → Publications.
BEEHIIV_PUBLICATION_ID=

# --- Optional ---
# Canonical site URL (used by sitemap/robots/metadata). Defaults to production.
# NEXT_PUBLIC_SITE_URL=https://aetherpeptide.com
